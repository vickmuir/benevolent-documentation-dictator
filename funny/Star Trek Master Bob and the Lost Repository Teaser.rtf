\outl0\strokewidth0 \strokec2 Star Trek: Master Bob and the Lost Repository\
\pard\pardeftab720\sa348\partightenfactor0

\fs42 \cf0 Teaser\
\pard\pardeftab720\sa327\partightenfactor0

\fs32\fsmilli16380 \cf0 FADE IN:\
\pard\pardeftab720\sa280\partightenfactor0

\fs28 \cf0 SOUND:
\f1\b0  Deep space ambience. A low, distant hum.\

\f0\b MUSIC:
\f1\b0  Warm orchestral theme reminiscent of a classic exploration adventure.\
